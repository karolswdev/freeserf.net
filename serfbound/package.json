{
  "name": "serfbound-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -b packages/engine packages/assets packages/test-support packages/app",
    "build:web": "npm run build && vite build",
    "clean": "tsc -b --clean packages/engine packages/assets packages/test-support packages/app",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:ci",
    "test:browser": "npm run build:web && playwright test",
    "test:ci": "npm run test:unit && npm run test:browser",
    "test:unit": "npm run build && node --test tests/ci/*.test.mjs",
    "test:local:assets": "node scripts/test-local-assets.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
