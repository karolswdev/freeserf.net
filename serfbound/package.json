{
  "name": "serfbound-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -b packages/engine packages/assets packages/test-support packages/app",
    "build:web": "npm run build && vite build",
    "capture:local:screenshots": "npm run build:web && node scripts/capture-local-screenshots.mjs",
    "ci:release": "npm test && npm run check:boundaries && npm run test:release:static && npm run test:docs && npm run test:local:assets",
    "clean": "tsc -b --clean packages/engine packages/assets packages/test-support packages/app",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:release-artifact": "node scripts/check-release-artifact.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "release:static": "npm run build:web && npm run check:release-artifact",
    "test": "npm run test:ci",
    "test:browser": "npm run build:web && playwright test",
    "test:compatibility": "node -e \"require('fs').rmSync('../pm/roadmap/serfbound/phase-8-browser-hardening/artifacts/story-04-browser-compatibility-report.json', { force: true })\" && npm run build:web && playwright test --config=playwright.compatibility.config.ts",
    "test:ci": "npm run test:unit && npm run test:browser",
    "test:docs": "node scripts/check-docs.mjs",
    "test:release:static": "npm run release:static && node scripts/test-static-hosting.mjs",
    "test:unit": "npm run build && node --test tests/ci/*.test.mjs",
    "test:local:assets": "node scripts/test-local-assets.mjs",
    "measure:scale": "node scripts/measure-scale.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
